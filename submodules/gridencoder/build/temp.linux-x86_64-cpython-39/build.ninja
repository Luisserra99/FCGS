ninja_required_version = 1.3
cxx = c++
nvcc = /d01/luis/miniconda3/envs/FCGS/bin/nvcc

cflags = -pthread -B /d01/luis/miniconda3/envs/FCGS/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /d01/luis/miniconda3/envs/FCGS/include -fPIC -O2 -isystem /d01/luis/miniconda3/envs/FCGS/include -fPIC -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/TH -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/THC -I/d01/luis/miniconda3/envs/FCGS/include -I/d01/luis/miniconda3/envs/FCGS/include/python3.9 -c
post_cflags = -O3 -std=c++14 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gridencoder -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/TH -I/d01/luis/miniconda3/envs/FCGS/lib/python3.9/site-packages/torch/include/THC -I/d01/luis/miniconda3/envs/FCGS/include -I/d01/luis/miniconda3/envs/FCGS/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++14 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_HALF2_OPERATORS__ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_gridencoder -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=sm_86
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



build /d01/luis/FCGS/submodules/gridencoder/build/temp.linux-x86_64-cpython-39/d01/luis/FCGS/submodules/gridencoder/src/bindings.o: compile /d01/luis/FCGS/submodules/gridencoder/src/bindings.cpp
build /d01/luis/FCGS/submodules/gridencoder/build/temp.linux-x86_64-cpython-39/d01/luis/FCGS/submodules/gridencoder/src/gridencoder.o: cuda_compile /d01/luis/FCGS/submodules/gridencoder/src/gridencoder.cu





